{
  "name": "petsforvets-v2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --names api,web --prefix-colors blue,green --kill-others-on-fail \"npm:api\" \"npm:dev:web\"",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "api": "cd api && go run ./cmd/server",
    "dev:web": "vite"
  },
  "dependencies": {
    "@lucide/vue": "^1.73.0",
    "@primeuix/themes": "^1.2.5",
    "@primevue/forms": "^4.5.5",
    "bootstrap": "^5.3.9",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@primevue/auto-import-resolver": "^4.5.5",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.7",
    "typescript": "^6.0.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.8",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.14"
  }
}
